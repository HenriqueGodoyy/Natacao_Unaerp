# Credenciais do Supabase
# 1. Copie este arquivo para ".env" (na pasta natacao-unaerp/)
# 2. Preencha os valores abaixo (Painel Supabase: Project Settings -> API)
# 3. Reinicie o servidor: npm run dev
#
# OBS: o .env NAO deve ser commitado (ja esta no .gitignore).

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_KEY=sua-chave-publishable-ou-anon
